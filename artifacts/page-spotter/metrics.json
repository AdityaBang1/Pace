    "device": "cuda",
    "wall_seconds": 932.2,
    "reproducibility": "seeded; cuDNN kernels are not deterministic"
  },
  "thresholds": {
    "peak": 0.35,
    "min_confidence": 0.5,
    "tuned_on_evaluation_documents": false
  },
  "reading": {
    "views": 2,
    "arithmetic": "float64: the network is read as a double copy, so the fields do not depend on whether a CPU or a GPU ran the convolutions",
    "second_view": "shift (3.0, 2.0) px, scale 1.015 about the centre",
    "rule": "a field is emitted only where both readings produced the same raw text; any disagreement is a refusal",
    "unpaired": "rows only one reading saw are counted, never emitted"
  },
