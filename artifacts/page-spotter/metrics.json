  "model": {
    "name": "PageSpotter",
    "description": "one fully convolutional network; per-position character presence and class at half resolution; no template, no grid, no detector stage, no parser",
    "parameters": 290161,
    "output_stride": 2,
    "frame": [
      1224,
      1584
    ],
    "charset": 64
  },
  "data": {
    "train_documents": 800,
    "heldout_documents": 60,
    "train_pages": 1379,
    "heldout_pages": 104,
    "train_seed": 20261022,
    "heldout_seed": 880123,
    "split": "by document: no held-out page belongs to a training document",
    "family": "portrait US letter at 2 px/pt, the renderer's columns, 9-10 pt Arial (Helvetica metrics), wrapped titles, lower-case course codes",
    "degradation": "illumination, blur and JPEG; a quarter of training pages clean; held-out pages all degraded",
    "targets": "presence on every printed glyph; class only on the four measured fields",
    "example_gold": [
      {
        "course_code": "708584o",
        "mark": "56",
        "weight": 0.5,
